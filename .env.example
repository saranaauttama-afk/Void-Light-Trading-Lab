PORT=8787
VITE_API_BASE=http://localhost:8787
# Server-side only. Never put this in a VITE_* variable or browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- Live trading (Binance Spot) ---
# Off unless BOTH of these are true: this exact flag, and valid credentials below.
LIVE_TRADING_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Defaults to testnet even if this var is missing/blank. To go to mainnet you
# must ALSO set CONFIRM_MAINNET_TRADING=true below — one flag is not enough.
BINANCE_USE_TESTNET=true
CONFIRM_MAINNET_TRADING=false

# Optional: shifts which clock the daily P&L/trade-count reset uses.
# Minutes offset from UTC, e.g. 420 for UTC+7 (Thailand). Default 0 (UTC).
DAILY_RESET_TZ_OFFSET_MINUTES=0
